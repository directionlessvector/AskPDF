# Postgres local development database
POSTGRES_DB=askpdf
POSTGRES_USER=askpdf
POSTGRES_PASSWORD=askpdf
POSTGRES_PORT=5432

# API local development service
API_APP_NAME=AskPDF API
API_ENVIRONMENT=local
API_PORT=8000

# Web local development service
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Qdrant local vector database
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# LocalStack local AWS emulator for S3 and SQS
LOCALSTACK_SERVICES=s3,sqs
LOCALSTACK_EDGE_PORT=4566
LOCALSTACK_DEBUG=0
AWS_DEFAULT_REGION=us-east-1
